# Local API / API local
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Development trusts exact loopback hosts on dynamic ports. LAN browser origins
# require an explicit entry. In production only this list is trusted; no '*'.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# npm web/mobile/bundle and release:web read this public URL from the root .env.
# Existing shell/provider values take precedence, including an explicitly empty value.
# Production release requires the real deployed HTTPS API URL ending in /v1.
# For an Android emulator use http://10.0.2.2:3000/v1; a physical device needs a reachable LAN URL.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/v1
# Copy to .env and supply distinct, strong local passwords. Never commit .env.
POSTGRES_PASSWORD=
POSTGRES_TEST_PASSWORD=
# URL-encode passwords when assembling these URLs. No credentials are supplied.
DATABASE_URL=
# Only loopback hosts and database names ending in _test are allowed by tests.
TEST_DATABASE_URL=
