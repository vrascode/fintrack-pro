generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  CASH
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum GoalStatus {
  ACTIVE
  CLOSED
}

enum BillFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String        @unique @db.VarChar(254)
  passwordHash    String        @db.VarChar(255)
  emailVerifiedAt DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  authTokens      AuthToken[]
  accounts        Account[]
  categories      Category[]
  transactions    Transaction[]
  budgets         MonthlyBudget[]
  goals           SavingsGoal[]
  bills           Bill[]
  creditCards     CreditCard[]
  cardPurchases   CardPurchase[]
  cardPayments    CardPayment[]
}

model Session {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @db.Uuid
  deviceName        String         @db.VarChar(100)
  accessTokenHash   String         @unique @db.VarChar(64)
  accessExpiresAt   DateTime       @db.Timestamptz(3)
  expiresAt         DateTime       @db.Timestamptz(3)
  absoluteExpiresAt DateTime       @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?      @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AuthToken {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @db.VarChar(64)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime         @db.Timestamptz(3)
  consumedAt DateTime?        @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Account {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(80)
  type         AccountType
  currency     String        @default("BRL") @db.Char(3)
  openingBalanceCents BigInt   @default(0)
  openingBalanceOn     DateTime @default(now()) @db.Date
  includeInPlanning    Boolean  @default(true)
  archivedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionAccount")
  transfers    Transaction[] @relation("TransactionTransferAccount")
  bills        Bill[]

  @@unique([userId, id])
  @@index([userId, archivedAt, createdAt])
}

model Category {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(60)
  kind         CategoryKind
  essentialForReserve Boolean @default(false)
  archivedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      MonthlyBudget[]
  bills        Bill[]
  cardPurchases CardPurchase[]

  @@unique([userId, id])
  @@unique([userId, kind, name])
  @@index([userId, archivedAt])
}

model Transaction {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @db.Uuid
  accountId         String          @db.Uuid
  transferAccountId String?         @db.Uuid
  categoryId        String?         @db.Uuid
  kind              TransactionKind
  amountCents       BigInt
  description       String          @db.VarChar(160)
  notes             String?         @db.VarChar(1000)
  occurredOn        DateTime        @db.Date
  idempotencyKey    String          @db.VarChar(128)
  revision          Int             @default(1)
  voidedAt          DateTime?       @db.Timestamptz(3)
  changes           TransactionChange[]
  billPayment       BillPayment?
  cardPayment       CardPayment?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("TransactionAccount", fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  transferAccount   Account?        @relation("TransactionTransferAccount", fields: [userId, transferAccountId], references: [userId, id], onDelete: NoAction)
  category          Category?       @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredOn, createdAt])
  @@index([userId, accountId, occurredOn])
  @@index([userId, categoryId, occurredOn])
}

model Bill {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @db.Uuid
  accountId     String        @db.Uuid
  categoryId    String?       @db.Uuid
  kind          CategoryKind
  description   String        @db.VarChar(160)
  amountCents   BigInt
  firstDueOn    DateTime      @db.Date
  frequency     BillFrequency
  canceledAt    DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  category      Category?     @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)
  payments      BillPayment[]

  @@unique([userId, id])
  @@index([userId, firstDueOn])
}

model BillPayment {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @db.Uuid
  billId         String      @db.Uuid
  occurrenceOn   DateTime    @db.Date
  amountCents    BigInt
  idempotencyKey String      @db.VarChar(128)
  transactionId  String      @unique @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  bill           Bill        @relation(fields: [userId, billId], references: [userId, id], onDelete: NoAction)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@unique([userId, idempotencyKey])
  @@index([userId, billId, occurrenceOn])
}

model CreditCard {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  name         String   @db.VarChar(80)
  institution  String   @db.VarChar(80)
  lastFour     String?  @db.Char(4)
  limitCents   BigInt
  closingDay   Int
  dueDay       Int
  color        String   @db.Char(7)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases    CardPurchase[]
  payments     CardPayment[]

  @@unique([userId, id])
  @@index([userId, archivedAt])
}

model CardPurchase {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String @db.Uuid
  cardId           String @db.Uuid
  categoryId       String? @db.Uuid
  description      String @db.VarChar(160)
  amountCents      BigInt
  purchasedOn      DateTime @db.Date
  installmentCount Int
  idempotencyKey   String @db.VarChar(128)
  canceledAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             CreditCard @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)
  category         Category? @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)
  installments     CardInstallment[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, id])
  @@index([userId, cardId, purchasedOn])
}

model CardInstallment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId   String @db.Uuid
  number       Int
  invoiceMonth DateTime @db.Date
  amountCents  BigInt
  purchase     CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@index([invoiceMonth])
}

model CardPayment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String @db.Uuid
  cardId         String @db.Uuid
  invoiceMonth   DateTime @db.Date
  amountCents    BigInt
  idempotencyKey String @db.VarChar(128)
  transactionId  String @unique @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           CreditCard @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@unique([userId, idempotencyKey])
  @@index([userId, cardId, invoiceMonth])
}

model TransactionChange {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String      @db.Uuid
  revision      Int
  operation     String      @db.VarChar(10)
  snapshot      Json
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, revision])
}

model MonthlyBudget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  month      DateTime @db.Date
  limitCents BigInt
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model SavingsGoal {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @db.Uuid
  name           String             @db.VarChar(100)
  targetCents    BigInt
  targetOn       DateTime?          @db.Date
  status         GoalStatus         @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions  GoalContribution[]

  @@unique([userId, id])
  @@index([userId, status, createdAt])
}

model GoalContribution {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @db.Uuid
  goalId       String      @db.Uuid
  idempotencyKey String    @db.VarChar(128)
  amountCents  BigInt
  note         String?     @db.VarChar(160)
  contributedOn DateTime   @db.Date
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  goal         SavingsGoal @relation(fields: [userId, goalId], references: [userId, id], onDelete: Cascade)

  @@index([userId, goalId, contributedOn])
  @@unique([userId, idempotencyKey])
}
