{
  "expo": {
    "name": "FinTrack Pro",
    "slug": "fintrack-pro",
    "scheme": "fintrack-pro",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.fintrackpro.app" },
    "android": {
      "package": "com.fintrackpro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/android/monochrome.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "FinTrack Pro",
      "shortName": "FinTrack",
      "lang": "pt-BR",
      "themeColor": "#C84A01",
      "backgroundColor": "#0A0A0A",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/",
      "favicon": "./assets/brand/web/favicon.png"
    }
  }
}
