{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "env": { "FINTRACK_RELEASE": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": { "FINTRACK_RELEASE": "1" }
    }
  }
}
